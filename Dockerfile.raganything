# syntax=docker/dockerfile:1

FROM python:3.12-slim

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libreoffice \
        libgl1 \
        libglib2.0-0 \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml .
COPY setup.py .
COPY uv.lock .
COPY lightrag/ ./lightrag/

RUN uv sync --frozen --no-dev --extra api --extra offline --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade \
    && /app/.venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.11.0 torchvision==0.26.0 \
    && /app/.venv/bin/python -m pip install --no-cache-dir raganything "mineru[core]"

ENV PATH=/app/.venv/bin:$PATH
ENV WORKING_DIR=/app/data/rag_storage
ENV INPUT_DIR=/app/data/inputs

RUN mkdir -p /app/data/rag_storage /app/data/inputs /app/data/job_spool /app/data/raganything_output

ENTRYPOINT ["python", "-m", "lightrag.sidecar.worker"]
